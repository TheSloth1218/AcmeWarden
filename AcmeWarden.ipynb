   "source": [
    "## Step 8: Build the tool\n",
    "\n",
    "Write the classifier: a strict prompt, one `ask_model` call, then defensive parsing that falls back to `Label.UNKNOWN`. (You may rename `triage_log` to match your tool if you like.)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "2e75d253",
   "metadata": {},
   "outputs": [],
   "source": [
    "def triage_log(line: str) -> Triage:\n",
    "    prompt = (\n",
    "        \"You are a security log triage assistant.\\n\"\n",
    "        \"Classify the log line as BENIGN, SUSPICIOUS, or MALICIOUS and give a one \"\n",
    "        \"sentence reason.\\n\"\n",
    "        \"Reply in EXACTLY this format:\\n\"\n",
    "        \"LABEL: <BENIGN|SUSPICIOUS|MALICIOUS>\\n\"\n",
    "        \"REASON: <one sentence>\\n\\n\"\n",
    "        f\"Log line:\\n{line}\\n\"\n",
    "    )\n",
    "\n",
    "    text = ask_model(prompt)\n",
    "\n",
    "    label_match = LABEL_RE.search(text)\n",
    "    raw = label_match.group(1).upper() if label_match else \"UNKNOWN\"\n",
    "\n",
    "    label = Label(raw) if raw in Label.__members__ else Label.UNKNOWN\n",
    "\n",
    "    reason_match = REASON_RE.search(text)\n",
    "    reason = reason_match.group(1).strip() if reason_match else text.strip()\n",
    "\n",
    "    return Triage(line=line, label=label, reason=reason)"
   ]
  },
