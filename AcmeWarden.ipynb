    "from datetime import datetime\n",
    "\n",
    "def write_report(results, tool_name, path=\"assessment.md\"):\n",
    "    with open(path, \"w\", encoding=\"utf-8\") as f:\n",
    "        f.write(f\"# {tool_name} Security Log Assessment\\n\\n\")\n",
    "        f.write(f\"Generated: {datetime.now():%Y-%m-%d %H:%M}\\n\\n\")\n",
    "        f.write(f\"Entries assessed: {len(results)}\\n\\n\")\n",
    "        for r in results:\n",
    "            f.write(f\"- **{r.label.value}** {r.reason}\\n\")\n",
    "            f.write(f\"  - `{r.line}`\\n\")\n",
    "    return path\n",
    "\n",
    "report_path = write_report(results, AcmeWarden)\n",
    "print(\"Wrote\", report_path, \"\\n\")\n",
    "print(open(report_path, encoding=\"utf-8\").read())"
