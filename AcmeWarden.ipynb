   "source": [
    "## Step 6: Define the result type and parsers\n",
    "\n",
    "An `Enum` fixes the labels, a `dataclass` gives a typed result, and two regexes extract the fields."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "cf1e7493",
   "metadata": {},
   "outputs": [],
   "source": [
    "from dataclasses import dataclass\n",
    "from enum import Enum\n",
    "import re\n",
    "\n",
    "class Label(str, Enum):\n",
    "    BENIGN = \"BENIGN\"\n",
    "    SUSPICIOUS = \"SUSPICIOUS\"\n",
    "    MALICIOUS = \"MALICIOUS\"\n",
    "    UNKNOWN = \"UNKNOWN\"\n",
    "\n",
    "@dataclass\n",
    "class Triage:\n",
    "    line: str\n",
    "    label: Label\n",
    "    reason: str\n",
    "\n",
    "LABEL_RE = re.compile(r\"^LABEL:\\s*(\\w+)\", re.IGNORECASE | re.MULTILINE)\n",
    "REASON_RE = re.compile(r\"^REASON:\\s*(.+)\", re.IGNORECASE | re.MULTILINE)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "332d5958",
   "metadata": {},
   "source": [
